package combined_generator;
import java.util.Random;
import java.util.Scanner;
/**
 *
 * @author jleonhardt2027
 */
public class Combined_Generator {

    /**
     * @param args the command line arguments
     */

    public static void main(String[] args) {
        try (Scanner scan = new Scanner(System.in)) {
            Random generator = new Random();
            String input = "";
            
            do {
                System.out.println("Enter 'p' to generate a phone number, 'r' to roll the die, or '-1' to stop:");
                input = scan.next();
                
                if (input.equalsIgnoreCase("p")) {
                    // Phone Number Generator
                    int num1 = generator.nextInt(8);
                    int num2 = generator.nextInt(8);
                    int num3 = generator.nextInt(8);
                    int num4 = generator.nextInt(10);
                    int num5 = generator.nextInt(10);
                    int num6 = generator.nextInt(10);
                    int num7 = generator.nextInt(10);
                    int num8 = generator.nextInt(10);
                    int num9 = generator.nextInt(10);
                    int num10 = generator.nextInt(10);
                    
                    System.out.println("Your number is " + num1 + num2 + num3 + "-" + num4 + num5 + num6 + "-" + num7 + num8 + num9 + num10);
                    
                } else if (input.equalsIgnoreCase("r")) {
                    // 6-Sided Die Generator
                    int num1 = generator.nextInt(6); // range 0 through 5
                    System.out.println("You rolled a " + (num1 + 1)); // range 1 through 6
                    
                } else if (!input.equals("-1")) {
                    System.out.println("Invalid option. Please enter 'p', 'r', or '-1'.");
                }
                
            } while (!input.equals("-1"));//loop

        }
    }
}
